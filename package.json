{
  "name": "agent-desktop",
  "productName": "Agent Desktop",
  "version": "0.1.0",
  "description": "Agent Desktop - a Windows desktop client for DeepSeek Harness: an Electron shell over the in-process DSH host.",
  "private": true,
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "brand": "node scripts/brand.mjs",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build:main": "tsc -p tsconfig.json",
    "build:preload": "tsc -p tsconfig.preload.json",
    "build:assets": "node scripts/copy-assets.mjs",
    "build:feedback-archive": "cd packages/dsh-tool-feedback-archive && tsc -p tsconfig.json && tsdown && node ../../scripts/verify-archive-client.mjs",
    "build:example": "cd packages/dsh-tool-example && tsc -p tsconfig.json",
    "build": "npm run build:example && npm run build:feedback-archive && npm run build:main && npm run build:preload && npm run build:assets",
    "bundle:portable": "node scripts/bundle-portable.mjs",
    "start": "npm run build && electron .",
    "icon": "node scripts/make-icon.mjs",
    "dist": "npm run build && electron-builder --config electron-builder.config.cjs --win",
    "dist:dir": "npm run build && electron-builder --config electron-builder.config.cjs --win --dir",
    "selfcheck": "npm run selfcheck:shell && npm run selfcheck:portable && npm run selfcheck:locale && npm run selfcheck:presets",
    "selfcheck:shell": "electron scripts/selfcheck-phase2.mjs",
    "selfcheck:portable": "electron scripts/selfcheck-portable.mjs",
    "selfcheck:locale": "electron scripts/selfcheck-locale.mjs",
    "selfcheck:presets": "node scripts/selfcheck-presets.mjs",
    "audit:capabilities": "electron scripts/audit-capabilities.mjs",
    "audit:extensibility": "electron scripts/audit-extensibility.mjs",
    "audit:locale": "electron scripts/audit-locale.mjs",
    "audit:agent-loop": "electron scripts/audit-agent-loop.mjs",
    "audit:mode-switching": "electron scripts/audit-mode-switching.mjs",
    "audit:self-maintenance": "electron scripts/audit-self-maintenance.mjs",
    "audit:hot-update": "electron scripts/audit-hot-update.mjs",
    "audit:layering": "electron scripts/audit-layering.mjs",
    "audit:agent-layer-mapping": "electron scripts/audit-agent-layer-mapping.mjs",
    "audit:kernel-iteration": "electron scripts/audit-kernel-iteration.mjs",
    "audit:dev-loop": "electron scripts/audit-dev-loop.mjs",
    "audit:two-loops": "electron scripts/audit-two-loops.mjs",
    "audit:sequential-harness": "electron scripts/audit-sequential-harness.mjs",
    "verify:packaged-preset-repair": "node scripts/verify-packaged-preset-repair.mjs",
    "verify:packaged-ui": "node scripts/verify-packaged-ui.mjs",
    "verify:packaged-packages": "node scripts/audit-packaged-packages.mjs release/win-unpacked/resources/app.asar",
    "verify:profile-deps": "node scripts/audit-profile-dependencies.mjs release/win-unpacked/resources/desktop-profile node_modules",
    "verify:which-copy": "node scripts/which-copy-loads.mjs release/win-unpacked/resources node_modules/@deepseek-ai/dsh-subprocess-local/lib/runner-launch-COYGu0Dl.js node_modules/@deepseek-ai/dsh-tool-fs-search/lib/index.js",
    "postdist": "node scripts/audit-packaged-packages.mjs release/win-unpacked/resources/app.asar && node scripts/audit-profile-dependencies.mjs release/win-unpacked/resources/desktop-profile node_modules",
    "experiment:replace-loop": "electron scripts/experiment-replace-loop.mjs",
    "experiment:hot-update": "electron scripts/experiment-hot-update.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "electron": "^37.10.3",
    "electron-builder": "^26.15.3",
    "tsdown": "^0.23.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@deepseek-ai/cordis-plugin-group": "1.0.2",
    "@deepseek-ai/dsh": "0.1.5-rc.2",
    "@deepseek-ai/dsh-anonymous-user-id": "0.1.5-rc.2",
    "@deepseek-ai/dsh-attachment": "0.1.5-rc.2",
    "@deepseek-ai/dsh-authorization": "0.1.5-rc.2",
    "@deepseek-ai/dsh-bash-local": "0.1.5-rc.2",
    "@deepseek-ai/dsh-code-runtime": "0.1.5-rc.2",
    "@deepseek-ai/dsh-compaction": "0.1.5-rc.2",
    "@deepseek-ai/dsh-fs": "0.1.5-rc.2",
    "@deepseek-ai/dsh-hook-protocol": "0.1.5-rc.2",
    "@deepseek-ai/dsh-jobs": "0.1.5-rc.2",
    "@deepseek-ai/dsh-output-retention": "0.1.5-rc.2",
    "@deepseek-ai/dsh-sandbox": "0.1.5-rc.2",
    "@deepseek-ai/dsh-sdk-protocol": "0.1.5-rc.2",
    "@deepseek-ai/dsh-session-persistence": "0.1.5-rc.2",
    "@deepseek-ai/dsh-session-query": "0.1.5-rc.2",
    "@deepseek-ai/dsh-session-telemetry": "0.1.5-rc.2",
    "@deepseek-ai/dsh-session-title-llm": "0.1.5-rc.2",
    "@deepseek-ai/dsh-settings": "0.1.5-rc.2",
    "@deepseek-ai/dsh-shell": "0.1.5-rc.2",
    "@deepseek-ai/dsh-spill": "0.1.5-rc.2",
    "@deepseek-ai/dsh-subagent-in-process-driver": "0.1.5-rc.2",
    "@deepseek-ai/dsh-tool-example": "file:packages/dsh-tool-example",
    "@deepseek-ai/dsh-tool-feedback-archive": "file:packages/dsh-tool-feedback-archive",
    "@deepseek-ai/dsh-util-time": "0.1.5-rc.2",
    "@deepseek-ai/dsh-util-workspace-path": "0.1.5-rc.2",
    "@deepseek-ai/dsh-workflow": "0.1.5-rc.2"
  },
  "allowScripts": {
    "@deepseek-ai/dsh-subprocess-local@0.1.5-rc.2": true,
    "koffi@3.3.0": true,
    "node-pty@1.2.0-beta.15": true,
    "protobufjs@7.6.6": true,
    "@google/genai@1.52.0": true,
    "electron@37.10.3": true
  }
}
